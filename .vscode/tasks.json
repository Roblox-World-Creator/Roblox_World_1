    {
      "label": "Local AI: Start coding model",
      "type": "shell",
      "command": "$lms = \"${env:USERPROFILE}\\.lmstudio\\bin\\lms.exe\"; $loaded = (& $lms ps | Out-String); if ($loaded -notmatch 'qwen2.5-coder-7b-instruct') { & $lms load \"qwen2.5-coder-7b-instruct\" --gpu max --context-length 8192 --ttl 3600 -y }; & $lms server start --bind 127.0.0.1",
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": false
      }
    },
    {
      "label": "Local AI: Check model server",
      "type": "shell",
      "command": "Invoke-RestMethod -Uri http://127.0.0.1:1234/v1/models | ConvertTo-Json -Depth 5",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always"
