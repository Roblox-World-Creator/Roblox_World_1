      "command": "C:\\Users\\james\\AppData\\Local\\Roblox\\Versions\\version-a57f2f633baf4a86\\RobloxStudioBeta.exe",
      "args": [
        "C:\\Users\\james\\Documents\\platformer.rbxl"
      ],
      "problemMatcher": [],
